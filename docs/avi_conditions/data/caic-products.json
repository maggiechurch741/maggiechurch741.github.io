[{"id":"3ead6d62-2f4b-4c32-aa39-cd928208911a","type":"avalancheforecast","polygons":["0E5A5DFF-7518-494A-AD5E-7C20A1F98FFD","242191AB-2749-4585-A09B-C274A1C196D8","288624C3-E0C0-4816-86A1-57B068E20D5F","428340C8-91A8-480A-8FB8-322EAB7CD9EB","568FD9F5-9079-4965-BD83-8DD1577C9141","674FEC54-6A25-4F1B-9201-B145C6C609E0","6BE87E45-0574-4512-907F-EC3B9EBCA365","8908D9DD-0DED-4577-A8B4-6D8E48407182","93EA98DD-4165-4B8D-97F7-FE0774706466","98E60E8A-5124-454F-9660-9B879AE63B09","A3B7D9A2-121A-41EA-B824-ADCB4B1323A3","B4DBB658-8373-4DAB-8D42-7ABA0564AF9E","CB25CEAA-D3C0-416C-B11B-60B3BFF39F34","D6E3810F-1A94-4173-A5AD-147EEC39E464","D7362528-9E1C-4B04-ACEA-70E4F9BFB8B7","DBC40A27-66D6-4C9D-927E-1D5F05092F1A","E687FCD9-066C-4E47-8B6C-164C1B586A18","ECA6DAA1-1E5C-4D1F-8186-B9969A5E9EAD","EEF9E8C9-3899-4E76-8A11-C2265812FA53","F2A935D9-8E28-4421-8382-837E3E0E99B7","FCDD2204-2B10-4061-8CDF-928C5DE4C24D","FD36A9C3-DDBD-43BF-BA4B-AE2D2C8CA87F"],"areaId":"94eaa5fd3c0cb1de51e4c4c0a2a66160e54de3d4915159de3f7fc42886c93f60","issueDateTime":"2026-11-20T23:30:00Z","expiryDateTime":"2026-11-21T23:30:00Z","avalancheSummary":{"days":[{"date":"2026-11-21T23:30:00Z","content":"\u003cp\u003eRecent remote-triggered avalanches mean you should give a wide buffer to wind-drifted slopes near and above treeline to avoid triggering an avalanche that could bury you.\u003c/p\u003e\u003cp\u003eVery strong winds formed thicker and stiffer slabs on leeward slopes below ridgelines and in rocky gullies in the alpine. The most dangerous slopes face the north-half of the compass where weak snow lurks under these slabs. For safer travel options, seek out wind-sheltered areas. Conditions are safer below treeline.\u003c/p\u003e"}]},"media":{"Images":[{"id":"8d0b4d4a-85cc-56c0-9f14-36f129a943a8","url":"http://res.cloudinary.com/dozsqvbas/image/upload/v1795208103/AvIDfx/vztqb4vrm6lodq61xsiw.webp","width":2500,"height":3333,"credit":"","caption":"\u003cp\u003eStrong winds on Tuesday, November 17th drastically changed conditions in the San Juan Mountains, finally forming a cohesive slab over our buried weak layer. The following day, numerous avalanches were triggered by backcountry travelers, mostly on north and northeast-facing terrain above treeline. Steep, leeward, shady slopes like the one pictured here continue to be our most dangerous areas. This trio of avalanches on Trico Peak was triggered on 11/18 by two skiers, and one slide momentarily caught one of them.\u003c/p\u003e","tag":"avalanche","altText":"Multiples avalanches on a shady, rocky mountain face. ","dateTaken":"2026-11-18T18:33:45Z","isArchived":false},{"id":"0adfbc58-1065-53e8-a2c7-6e2facacbf1d","url":"http://res.cloudinary.com/dozsqvbas/image/upload/v1795208413/AvIDfx/t1ijvkbxbjlz3oxdt3kg.webp","width":2500,"height":1875,"credit":"","caption":"\u003cp\u003eThis avalanche was remotely-triggered by a skier traversing underneath the slope and perfectly illustrates our new Persistent Slab avalanche problem. Weak snow developed during a 10-day dry spell in early November and the slab that sits on top of it is getting stiffer and more connected, making remote-triggers a concern. This avalanche is small, but you trigger a large avalanche if you find the wrong slope. \u003c/p\u003e","tag":"avalanche","altText":"An avalanche below a rock outcropping with a ski track below it in a shady alpine bowl. ","dateTaken":"2026-11-18T21:40:51Z","isArchived":false},{"id":"7cf14c2f-f57e-5a4d-8f58-0453d475e571","url":"http://res.cloudinary.com/dozsqvbas/image/upload/v1795209088/AvIDfx/g1nm6w7bbyeanvdfvesg.webp","width":2500,"height":1215,"credit":"","caption":"\u003cp\u003eThis shows the potential size of avalanches that you could trigger. Wind drifted snow into thick slabs on steep, leeward slopes like this one, even down near treeline. Parts of the crown here measured almost 5 feet thick. \u003c/p\u003e","tag":"avalanche","altText":"An avalanche on a shady slope near treeline that runs over a roadcut. ","dateTaken":"2026-11-18T21:11:47.745Z","isArchived":false}]},"dangerRatings":{"days":[{"position":1,"alp":"moderate","tln":"moderate","btl":"low","date":"2026-11-21T23:30:00Z"},{"position":2,"alp":"moderate","tln":"moderate","btl":"low","date":"2026-11-22T23:30:00Z"}]},"avalancheProblems":{"days":[[{"type":"persistentSlab","aspectElevations":["w_tln","w_alp","nw_tln","nw_alp","n_tln","n_alp","ne_alp","ne_tln","e_alp","e_tln"],"likelihood":"possible","expectedSize":{"min":"1.0","max":"2.0"}}],[{"type":"persistentSlab","aspectElevations":["w_tln","w_alp","nw_tln","nw_alp","n_tln","n_alp","ne_alp","ne_tln","e_alp","e_tln"],"likelihood":"possible","expectedSize":{"min":"1.0","max":"2.0"}}]]}},{"id":"4543fcc9-a33c-413d-bbde-77ed4117395f","type":"avalancheforecast","polygons":["002F1CBA-C06D-4135-A893-FC464013B62B","00F5A524-1F4A-4318-9D53-9A3F42EAAD78","031F974D-8D27-40AF-9646-0D96A728826F","07217D33-65CD-450C-870A-EC2693445190","0FAA4D28-2B56-40A5-A79C-E534A07D98ED","14EEEAD3-1AC2-4C19-A8F7-36AD6060F101","184B517E-9DEF-44B4-9EA8-E45CC96DB776","1D7238EB-F0EA-4A4C-A425-2F10917D7645","24890DB8-FD42-4988-80B7-82367FD5E8F1","2CADF229-A5B1-420C-9A58-0D72FE71FDCD","2D929612-B1FD-4AC4-BA12-494ADDCBB442","30C5E3BC-D260-4F9E-B46D-717CCBA6C77E","34FE3430-9CD0-4470-891D-E54D8C2A4E29","389E01FC-0600-42E2-82FF-BEF3B23C6105","3C27CD1A-FD13-48B3-B0FF-A5947832FBEB","3CB9AF64-6F72-4629-A428-E956567BE819","3F69D3A0-1915-4E8E-AB3F-8F3961B64F10","40CAA2D1-6467-40BA-A652-5E1EBE1AABBB","4481315B-A3B2-430F-AD25-51F077D30A1A","464239AD-281A-4E5E-825C-AA4A668FBBCC","468B78D0-198E-4FA4-A2CD-09F436CBA5EE","49B9973C-4E52-4B70-A4A9-4718AFB95868","4ADCB7E9-CFDB-462F-B6FB-E787CF1EA2C6","59DA954B-77EC-49A4-B270-169CACB0E2EE","5AD4C8BF-731F-4B70-8A78-C3D3151A85DD","61E64E4C-03E7-433B-B273-22BF6C97E026","6BA1B136-8A8E-4987-83B3-F2DDDDB2DFB7","71056143-E59C-42C0-8E82-43F29CC720C4","7183F4E9-26AF-4D12-9B99-A4B42A3D01A3","74C9EF65-0B33-4764-A2BF-0B2F71F0110E","7696EB7F-C450-4967-B4BF-C4928C6F82D0","7E3F4D07-B8FB-49CB-8B24-F67304294AEA","8385ACB2-7117-4757-AB18-37F26935DF3E","83E646AA-35CC-4D48-ACD4-A9DD165D0FA0","865AEF1B-7C59-4771-9A78-62BD6718404A","947E5EB1-C540-4654-B72B-E92FACD4DA89","98171DBD-49BD-41E6-89AD-222BC932C5CD","9AB77E3D-5C1C-4DAF-B0C5-81B066FB46AE","9D94D73F-C7DC-4C33-AF8A-1EC8A490D5A9","9F0C6D78-4C62-4DDA-8850-5AE4C83E2FF1","A184002D-BBFC-45DA-A94B-B64AC1B5D0E7","AB799973-D423-4150-9486-EC2BCF7ED731","AD6B1059-5E99-43DC-B921-1DA648F30368","B65805C7-DE42-4F35-BDEE-14E7D6B7605A","B6E88FB0-589D-4F0A-966F-DFF05CE159DC","B868BD7F-CC6D-418F-95EA-BD8B43354FA3","C5F1EC58-8972-45C2-9F1F-D5835EF0652C","C835BE8E-EC55-4C2B-8B52-815C66D0209C","D71F4D50-11F3-4B8E-A961-6704FD21D51B","D892417F-5570-4940-A311-AA918B8A2AF7","E4DE90A5-20FE-4A8F-B297-163BA41C19C9","EEE05A8E-51CF-4AF4-9509-EC7C64D14D20","F9BD77AC-C360-47DF-8195-D16A4C65DE30","FCEB8EE2-B8A0-44E8-ABD9-EEED4EDDDAA7"],"areaId":"12ca9cc89b90a1816d37a471c5d8dc0c8e444515d1968da9774762b57e341c9c","issueDateTime":"2026-11-20T23:30:00Z","expiryDateTime":"2026-11-21T23:30:00Z","avalancheSummary":{"days":[{"date":"2026-11-21T23:30:00Z","content":"\u003cp\u003eThere isn't enough snow for avalanches on most slopes. Steer around hard drifts of snow on steep terrain features and below ridgetop in the alpine. \u003c/p\u003e"}]},"media":{"Images":[{"id":"8e5c6f05-3298-5eaa-bd29-50115fabbce0","url":"http://res.cloudinary.com/dozsqvbas/image/upload/v1794861348/AvIDfx/likejgl8caflmbsiiout.webp","width":2500,"height":2500,"credit":"","caption":"\u003cp\u003eThis photo of South Diamond Peak shows about 10 to 20cm of snow that is generally all faceted. When we get some snow slopes like this will have a connected weak layer. \u003c/p\u003e","tag":"avalanche","altText":"Fore- and mid ground slopes are snow free. The alpine slopes in the distance have a shallow coating of snow.","dateTaken":"2026-11-15T22:38:36.884Z","isArchived":false},{"id":"57346306-9e5a-5d41-a7f0-2ce0015d1f44","url":"http://res.cloudinary.com/dozsqvbas/image/upload/v1793997784/AvIDfx/icjusqdprrk0hpzhydys.webp","width":2500,"height":1407,"credit":"","caption":"\u003cp\u003eMt. Richthofen and Mt. Mahler above Lake Agnes, near Cameron Pass. The slopes in these photos are mainly northwest-, north-, and northeast-facing. The thin snowpack on these slopes is turning into cohesionless snow. \u003c/p\u003e","tag":"avalanche","altText":"Steep, alpine peaks with a thin coating of snow.","dateTaken":"2026-11-05T20:47:16.593Z","isArchived":false},{"id":"fa87ef37-4726-537c-bf5c-9bcb34f46e87","url":"http://res.cloudinary.com/dozsqvbas/image/upload/v1794861415/AvIDfx/urzpzqb7izkjatjuzlya.webp","width":1202,"height":1602,"credit":"","caption":"\u003cp\u003eSurfaces in the Northern Mountains are generally very weak but there is no slab to cause an avalanche problem currently. \u003c/p\u003e","tag":"avalanche","altText":"Large feather like surface hoar.","dateTaken":"2026-11-15T16:57:21Z","isArchived":false},{"id":"e5ed8e17-a921-5d03-b26d-c7c89bdc8a0e","url":"http://res.cloudinary.com/dozsqvbas/image/upload/v1794861489/AvIDfx/ksh7ritug6tb8wxzfmg3.webp","width":2500,"height":1406,"credit":"","caption":"\u003cp\u003eThis footage from Coffee Pot road in the Flat Tops shows that although they may look snowy from a distance the coverage is pretty patchy \u003c/p\u003e","tag":"avalanche","altText":"A cliff-topped ridge with snowy slopes in the background transitions to forests and then ranches.","dateTaken":"2026-11-14T20:57:53.699Z","isArchived":false}]},"dangerRatings":{"days":[{"position":1,"alp":"low","tln":"low","btl":"low","date":"2026-11-21T23:30:00Z"},{"position":2,"alp":"low","tln":"low","btl":"low","date":"2026-11-22T23:30:00Z"}]},"avalancheProblems":{"days":[[],[]]}},{"id":"7437f839-5028-4778-adfc-5deae58abf4a","type":"avalancheforecast","polygons":["0BFCE84E-A2A4-4986-BF7D-84C1A0A2E467","0EF68DA6-9B2C-4366-BF30-4256AE6340BA","20D852D8-E47A-4447-ABE2-05E5F5E022D0","21F30165-D180-48B5-A36F-830F4DA1E8ED","30232C29-4A0C-4D7A-B951-EF7B873C2CBF","46C849AB-16F5-4