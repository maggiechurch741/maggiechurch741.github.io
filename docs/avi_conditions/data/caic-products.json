85D-427F-8D65-9DC8B58DBCE5","72283DBC-55B0-4638-A44E-7420893000C5","80965A3A-9069-422B-BD91-E0EABDFD44FE","851AFED0-5CE2-4E56-8465-F4FC73BF8FE7","8F48A7FC-A784-473E-BD34-0F789B505D14","977E9661-AE8E-45A5-9882-EC28C4B149AE","A03BDED3-E2F8-4E90-815E-397C421D386E","A1C44D1C-F76B-4597-832C-BA12E47501AF","A2D787FE-207C-489C-83F1-63715DEF6E7A","A50331E1-4A1D-4120-8D49-BDBD4BF7914C","B53342B7-BE91-47AD-81A7-21E7074B3FF3","BCFFEB80-C915-40FF-985D-5D7C7B99586A","C6D989AD-82E5-4DB9-96A4-15F364D6F09B","D15B6420-1FC0-4130-9AD2-760FD3F31DCD","D47A1D59-69BD-4DEE-9E6A-FCB28AC581B1","D5746397-17D6-4EE2-837F-6DA0AC4CD2D6","E431262C-0AE0-4E4B-9DA4-A2E35B49E671","E72F7052-876D-476F-89A0-9AEE369F0317","EC9276F5-8C4A-431C-882B-4BA90A9D8881","ED5C21DE-D335-4D82-85CF-485CD449C602","FE996429-CEFA-41FC-8228-3E4661406DDF"],"areaId":"d3f2b4ad988e4235c2da34d495cecad24c84423e2f0f85fbb0c3eeccdf09ab8a","issueDateTime":"2026-11-20T23:30:00Z","expiryDateTime":"2026-11-21T23:30:00Z","avalancheSummary":{"days":[{"date":"2026-11-21T23:30:00Z","content":"\u003cp\u003eMost slopes are generally safe from avalanches. You might be able to trigger a small avalanche where you encounter stiff, wind-drifted snow below ridgelines, on lee slopes, and around rocky outcrops in the alpine. \u003c/p\u003e"}]},"media":{"Images":[{"id":"5f5ef023-3d09-5890-8218-17304ab45039","url":"http://res.cloudinary.com/dozsqvbas/image/upload/v1795210883/AvIDfx/gbz7bayxncwpidp0ebei.webp","width":2500,"height":1875,"credit":"","caption":"\u003cp\u003eAbove treeline, you could find isolated pockets of stiff, wind-drifted snow. Look for cracking in the snow surface and try to avoid pillowy or wind-buffed drifts if you find them on steep alpine slopes.  \u003c/p\u003e","tag":"avalanche","altText":"A pole with a crack in the snow. ","dateTaken":"2026-11-17T20:59:36Z","isArchived":false},{"id":"a3f5512c-fc1f-5019-ba6b-7fa3c7498ece","url":"http://res.cloudinary.com/dozsqvbas/image/upload/v1795211049/AvIDfx/gcgfao5sa5aqtyc6neyn.webp","width":2500,"height":1875,"credit":"","caption":"\u003cp\u003eAvalanche danger is generally safe across the region because most slopes still don't have enough snow to produce avalanches. This is looking towards Buckeye Peak and the mountains near CO-91 (Fremont Pass). There is much less snow around this area than the Mosquito Range.\u003c/p\u003e","tag":"avalanche","altText":"A mountain that is mostly dry except for a little bit of snow on top. ","dateTaken":"2026-11-16T19:58:33Z","isArchived":false},{"id":"e09031a4-fb60-5252-8f5e-06152716411a","url":"http://res.cloudinary.com/dozsqvbas/image/upload/v1795211152/AvIDfx/d5nntsj8jdnffpny6siz.webp","width":2500,"height":1875,"credit":"","caption":"\u003cp\u003eAny snow that does exist across the region has been getting blasted by recent strong winds. These winds pressed snow in the alpine into thin and pockety slabs, especially below ridgelines and around rocky couloirs. This photo was taken during a strong wind event on Tuesday, November 17th near Twin Lakes. \u003c/p\u003e","tag":"avalanche","altText":"Winds blowing snow over a mountain ridge. ","dateTaken":"2026-11-17T21:47:41.639Z","isArchived":false}]},"dangerRatings":{"days":[{"position":1,"alp":"low","tln":"low","btl":"low","date":"2026-11-21T23:30:00Z"},{"position":2,"alp":"low","tln":"low","btl":"low","date":"2026-11-22T23:30:00Z"}]},"avalancheProblems":{"days":[[{"type":"windSlab","aspectElevations":["nw_alp","n_alp","ne_alp","e_alp"],"likelihood":"unlikely","expectedSize":{"min":"1.0","max":"1.5"}}],[]]}},{"id":"3ad312e2-2c5c-4ee1-88f9-eb741a11648c","type":"avalancheforecast","polygons":["028E2912-5D1A-4EC6-A22D-2180A797ECDD","071639C0-9D38-49C1-8AF3-F227A80F447D","3194EF47-46C9-4132-83C1-D156F9B94123","383548A5-2C8E-4CC6-985E-83F7AE17EAB6","7BA4F5A7-6E11-4A81-88FC-0A72429699A0","97694259-0F92-4CE6-A4C9-3A69D2C33F35","9DFB3103-D688-4AB3-B16D-EE6A20EA25A7","DAFC9825-B67E-4FF5-8E6C-4D05CC20E554"],"areaId":"eca6af8f59fdab95df2c9f6c913105e1d0407b0e9e2529069d4c3cc896761eae","issueDateTime":"2026-11-20T23:30:00Z","expiryDateTime":"2026-11-21T23:30:00Z","avalancheSummary":{"days":[{"date":"2026-11-21T23:30:00Z","content":"\u003cp\u003eYou can trigger an avalanche on slopes near and above treeline that face the north half of the compass. You can expect to see obvious signs of instability, such as cracking or collapsing in the snow, to warn you that you found a slab-over-weak-layer setup and should avoid traveling on or directly underneath steep slopes. Most of these avalanches will be small, but on slopes where wind drifted additional snow, they could grow large enough to bury you. \u003c/p\u003e"}]},"media":{"Images":[{"id":"a19c6b5e-b3b2-5ce0-a468-b79d9308995a","url":"http://res.cloudinary.com/dozsqvbas/image/upload/v1795044003/AvIDfx/gz97pxqxdjl1iubllua6.webp","width":2500,"height":1875,"credit":"CBAC","caption":"\u003cp\u003eHere's an example of the easy-to-trigger, but still-small avalanches you can expect in the Ruby Range or Elk Mountains on Thursday. With more snow piling on the same weak layer, expect a similar avalanche to break a little wider and run a little further on Friday.\u003c/p\u003e","tag":"avalanche","altText":"A small avalanche below","dateTaken":"2026-11-18T23:21:14.307Z","isArchived":false},{"id":"819c09a2-9022-5085-a7d5-9c0cddc46e50","url":"http://res.cloudinary.com/dozsqvbas/image/upload/v1794861822/AvIDfx/sjyfyryy136v1hbfldwr.webp","width":2500,"height":1681,"credit":"CBAC","caption":"\u003cp\u003eThis avalanche is a few days old, but it shows what's in store when a new slab forms. A weak, continuous layer of facets is now buried throughout most W-N-E-facing terrain at higher elevations, and it just needs a slab on top to become dangerous.\u003c/p\u003e","tag":"avalanche","altText":"A fresh avalanche in steep, rocky terrain with a person standing at the toe of the debris","dateTaken":"2026-11-15T20:43:47.407Z","isArchived":false}]},"dangerRatings":{"days":[{"position":1,"alp":"moderate","tln":"moderate","btl":"low","date":"2026-11-21T23:30:00Z"},{"position":2,"alp":"moderate","tln":"moderate","btl":"low","date":"2026-11-22T23:30:00Z"}]},"avalancheProblems":{"days":[[{"type":"persistentSlab","aspectElevations":["nw_alp","n_alp","ne_alp","e_alp","w_alp","w_tln","nw_tln","n_tln","ne_tln","e_tln"],"likelihood":"possible","expectedSize":{"min":"1.0","max":"2.0"}}],[{"type":"persistentSlab","aspectElevations":["nw_alp","n_alp","ne_alp","e_alp","w_alp","w_tln","nw_tln","n_tln","ne_tln","e_tln"],"likelihood":"possible","expectedSize":{"min":"1.0","max":"2.0"}}]]}}]