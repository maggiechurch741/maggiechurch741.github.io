[{"id":"fe262e6a-dbe9-4f7a-9059-f79ee33740f7","type":"avalancheforecast","polygons":["9D94D73F-C7DC-4C33-AF8A-1EC8A490D5A9","9F0C6D78-4C62-4DDA-8850-5AE4C83E2FF1"],"areaId":"ffb510d77b0e90dedb9dec37037d8d5b9e1d52508868ec3e0741242e6237e34a","issueDateTime":"2026-11-19T23:30:00Z","expiryDateTime":"2026-11-20T23:30:00Z","avalancheSummary":{"days":[{"date":"2026-11-20T23:30:00Z","content":"\u003cp\u003eStrong southwest winds will drift the new storm snow into slabs above treeline. Steer around drifted snow on steep slopes at upper elevations on the northerly half of the compass. It will be easy to trigger avalanches where you find the combination of drifted snow sitting on top of old snow layers in the alpine.\u003c/p\u003e"}]},"media":{"Images":[{"id":"612cda8a-6575-5add-bffc-fef809aa04e6","url":"http://res.cloudinary.com/dozsqvbas/image/upload/v1795033898/AvIDfx/oa596vdzvxape6p2vy0r.webp","width":2500,"height":1406,"credit":"","caption":"\u003cp\u003eSnow coverage is spotty right now and avalanches are unlikely. \u003c/p\u003e","tag":"avalanche","altText":"Snowy slopes with sparse trees and a road running through.","dateTaken":"2026-11-15T20:31:44.216Z","isArchived":false},{"id":"e056d572-5ba7-592e-8538-57270e825a21","url":"http://res.cloudinary.com/dozsqvbas/image/upload/v1795033973/AvIDfx/eglzl5gkfwdsu3frxfam.webp","width":1202,"height":1602,"credit":"","caption":"\u003cp\u003eMultiple days of cold clear nights have weakened the surface snow and all we are waiting for is a slab of firmer snow. \u003c/p\u003e","tag":"avalanche","altText":"Feathers of weak surface hoar at the surface.","dateTaken":"2026-11-15T20:32:58.307Z","isArchived":false}]},"dangerRatings":{"days":[{"position":1,"alp":"moderate","tln":"low","btl":"low","date":"2026-11-20T23:30:00Z"},{"position":2,"alp":"moderate","tln":"low","btl":"low","date":"2026-11-21T23:30:00Z"}]},"avalancheProblems":{"days":[[{"type":"windSlab","aspectElevations":["n_alp","ne_alp","e_alp","nw_alp"],"likelihood":"possible","expectedSize":{"min":"1.0","max":"2.0"}}],[{"type":"windSlab","aspectElevations":["n_alp","ne_alp","e_alp","nw_alp"],"likelihood":"possible","expectedSize":{"min":"1.0","max":"2.0"}}]]}},{"id":"f7aeea43-73e5-410e-85d3-558c1be5b709","type":"avalancheforecast","polygons":["028E2912-5D1A-4EC6-A22D-2180A797ECDD","071639C0-9D38-49C1-8AF3-F227A80F447D","3194EF47-46C9-4132-83C1-D156F9B94123","383548A5-2C8E-4CC6-985E-83F7AE17EAB6","7BA4F5A7-6E11-4A81-88FC-0A72429699A0","97694259-0F92-4CE6-A4C9-3A69D2C33F35","9DFB3103-D688-4AB3-B16D-EE6A20EA25A7","DAFC9825-B67E-4FF5-8E6C-4D05CC20E554"],"areaId":"eca6af8f59fdab95df2c9f6c913105e1d0407b0e9e2529069d4c3cc896761eae","issueDateTime":"2026-11-19T23:30:00Z","expiryDateTime":"2026-11-20T23:30:00Z","avalancheSummary":{"days":[{"date":"2026-11-20T23:30:00Z","content":"\u003cp\u003eYou can trigger an avalanche near and above treeline where you find a cohesive slab of new snow on top of cohesionless, weak snow on the north half of the compass. You may be able to trigger some of these avalanches from a distance, so be aware of steep slopes overhead. Most of these avalanches will be small, but in some areas where you encounter additional wind-drifted snow, you may be able to trigger an avalanche that is large enough to bury you. If you are traveling on west through north to east-facing slopes generally above around 11,000 feet, consider avoiding slopes steeper than around 30 degrees in consequential terrain.\u003c/p\u003e"}]},"media":{"Images":[{"id":"a19c6b5e-b3b2-5ce0-a468-b79d9308995a","url":"http://res.cloudinary.com/dozsqvbas/image/upload/v1795044003/AvIDfx/gz97pxqxdjl1iubllua6.webp","width":2500,"height":1875,"credit":"CBAC","caption":"\u003cp\u003eHere's an example of the easy-to-trigger, but still-small avalanches you can expect in the Ruby Range or Elk Mountains on Thursday. With more snow piling on the same weak layer, expect a similar avalanche to break a little wider and run a little further on Friday.\u003c/p\u003e","tag":"avalanche","altText":"A small avalanche below","dateTaken":"2026-11-18T23:21:14.307Z","isArchived":false},{"id":"819c09a2-9022-5085-a7d5-9c0cddc46e50","url":"http://res.cloudinary.com/dozsqvbas/image/upload/v1794861822/AvIDfx/sjyfyryy136v1hbfldwr.webp","width":2500,"height":1681,"credit":"CBAC","caption":"\u003cp\u003eThis avalanche is a few days old, but it shows what's in store when a new slab forms. A weak, continuous layer of facets is now buried throughout most W-N-E-facing terrain at higher elevations, and it just needs a slab on top to become dangerous.\u003c/p\u003e","tag":"avalanche","altText":"A fresh avalanche in steep, rocky terrain with a person standing at the toe of the debris","dateTaken":"2026-11-15T20:43:47.407Z","isArchived":false},{"id":"93973d38-4e6b-513d-934a-33178e0603aa","url":"http://res.cloudinary.com/dozsqvbas/image/upload/v1794775466/AvIDfx/nxygtth6iycbqwalet1j.webp","width":2500,"height":1875,"credit":"CAIC","caption":"\u003cp\u003eThe highlighted ridgeline is a feature you should consider avoiding. A little new snow and gusty winds could form small surface slabs that could break loose and sweep you down onto the exposed rocks below.\u003c/p\u003e","tag":"avalanche","altText":"A red circle highligts a snowy ridgeline","dateTaken":"2026-11-10T19:22:00Z","isArchived":false},{"id":"fe22735e-aa52-5939-b615-acb143276578","url":"http://res.cloudinary.com/dozsqvbas/image/upload/v1794775711/AvIDfx/bgnndew1sgiwdgyxm9nn.webp","width":960,"height":540,"credit":"CAIC","caption":"\u003cp\u003eThe snowpack is very weak at the surface with a supportive crust below. This setup will be dangerous once a new slab forms on top. Be on the lookout for any new drifted slabs at higher elevations, as they could be easy to trigger. \u003c/p\u003e","tag":"avalanche","altText":"A snow pit with red arrow showing where it was recorded","dateTaken":"2026-11-10T20:48:40.268Z","isArchived":false}]},"dangerRatings":{"days":[{"position":1,"alp":"moderate","tln":"moderate","btl":"low","date":"2026-11-20T23:30:00Z"},{"position":2,"alp":"moderate","tln":"moderate","btl":"low","date":"2026-11-21T23:30:00Z"}]},"avalancheProblems":{"days":[[{"type":"persistentSlab","aspectElevations":["nw_alp","n_alp","ne_alp","e_alp","w_alp","w_tln","nw_tln","n_tln","ne_tln","e_tln"],"likelihood":"possible","expectedSize":{"min":"1.0","max":"2.0"}}],[{"type":"persistentSlab","aspectElevations":["nw_alp","n_alp","ne_alp","e_alp","w_alp","w_tln","nw_tln","n_tln","ne_tln","e_tln"],"likelihood":"possible","expectedSize":{"min":"1.0","max":"2.0"}}]]}},{"id":"43f7aff2-a895-4edd-83dc-8c5713cfbedc","type":"avalancheforecast","polygons":["0E5A5DFF-7518-494A-AD5E-7C20A1F98FFD","242191AB-2749-4585-A09B-C274A1C196D8","288624C3-E0C0-4816-86A1-57B068E20D5F","428340C8-91A8-480A-8FB8-322EAB7CD9EB","568FD9F5-9079-4965-BD83-8DD1577C9141","674FEC54-6A25-4F1B-9201-B145C6C609E0","6BE87E45-0574-4512-907F-EC3B9EBCA365","8908D9DD-0DED-4577-A8B4-6D8E48407182","93EA98DD-4165-4B8D-97F7-FE0774706466","98E60E8A-5124-454F-9660-9B879AE63B09","A3B7D9A2-121A-41EA-B824-ADCB4B1323A3","B4DBB658-8373-4DAB-8D42-7ABA0564AF9E","CB25CEAA-D3C0-416C-B11B-60B3BFF39F34","D6E3810F-1A94-4173-A5AD-147EEC39E464","D7362528-9E1C-4B04-ACEA-70E4F9BFB8B7","DBC40A27-66D6-4C9D-927E-1D5F05092F1A","E687FCD9-066C-4E47-8B6C-164C1B586A18","ECA6DAA1-1E5C-4D1F-8186-B9969A5E9EAD","EEF9E8C9-3899-4E76-8A11-C2265812FA53","FCDD2204-2B10-4061-8CDF-928C5DE4C24D","FD36A9C3-DDBD-43BF-BA4B-AE2D2C8CA87F"],"areaId":"b9ab674f241e12b29521e4041407e13870b6e940bca800fdcd61471d9ac24dc4","issueDateTime":"2026-11-19T23:30:00Z","expiryDateTime":"2026-11-20T23:30:00Z","avalancheSummary":{"days":[{"date":"2026-11-20T23:30:00Z","content":"\u003cp\u003eYou can trigger avalanches large enough to bury you at upper elevations. You can trigger these slides from the side or bottom of a slope. Steer clear of steep slopes where you encounter wind-stiffened snow or see shooting cracks as you travel. Look for and avoid drifted snow below ridges and on the sides of gullies.\u003c/p\u003e\u003cp\u003eBelow treeline conditions are generally safe.\u003c/p\u003e"}]},"media":{"Images":[{"id":"37a28f07-893c-5bf8-93c3-49d44bcdca36","url":"http://res.cloudinary.com/dozsqvbas/image/upload/v1795036450/AvIDfx/eals6dxniyn9k85vp6zc.webp","width":512,"height":384,"credit":"CAIC","caption":"\u003cp\u003eA small, remote triggered wind slab avalanche on a northeast aspect in near treeline terrain.\u003c/p\u003e","tag":"avalanche","altText":"A small avalanche below a snowy ridge.","dateTaken":"2026-11-18T21:14:11.658Z","isArchived":false},{"id":"7f8a125b-a8eb-5671-998b-2987f245fb9c","url":"http://res.cloudinary.com/dozsqvbas/image/upload/v1795036828/AvIDfx/fqmf911hnirlkwgs2cxs.webp","width":512,"height":683,"credit":"CAIC","caption":"\u003cp\u003eA natural soft slab avalanche in above treeline terrain.\u003c/p\u003e","tag":"avalanche","altText":"A mountain peak with a cliff band in the middle.","dateTaken":"2026-11-18T21:20:29.553Z","isArchived":false},{"id":"215f2768-573b-5bef-aadd-8623f89ecd44","url":"http://res.cloudinary.com/dozsqvbas/image/upload/v1795039860/AvIDfx/ejjirz787rpwo23dtbbt.webp","width":1542,"height":2048,"credit":"CAIC","caption":"\u003cp\u003eEvidence of wind-loading above treeline.\u003c/p\u003e","tag":"avalanche","altText":"Looking up a snowy ridge at a mountain peak.","dateTaken":"2026-11-18T22:10:58.306Z","isArchived":false},{"id":"b1694eec-7ace-56c7-9556-c9802b92b4d5","url":"http://res.cloudinary.com/dozsqvbas/image/upload/v1794775178/AvIDfx/fc5gzuzgfi5tky9w4mfb.webp","width":2500,"height":1323,"credit":"","caption":"\u003cp\u003eBackcountry travellers triggered numerous small, soft slab avalanches. A storm starting overnight on Tuesday November 17 will bring avalanches like this back into the picture for Wednesday.\u003c/p\u003e","tag":"avalanche","altText":"ski tracks and a pair of small soft slab avalanches.","dateTaken":"2026-11-15T20:29:17.994Z","isArchived":false}]},"dangerRatings":{"days":[{"position"